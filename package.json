{
  "name": "alto",
  "version": "1.0.5",
  "description": "Alto - Professional Video Editor",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:renderer": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production && electron-builder build --win",
    "build:dir": "webpack --config webpack.config.js --mode production && electron-builder build --win --dir",
    "pack": "electron-builder --dir",
    "dist": "npm run build"
  },
  "keywords": [
    "video-editor",
    "electron"
  ],
  "author": "SilverWallDiscs",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.1.7",
    "electron-log": "^5.1.2",
    "fluent-ffmpeg": "^2.1.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^28.2.2",
    "electron-builder": "^24.9.1",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4",
    "html-webpack-plugin": "^5.6.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "file-loader": "^6.2.0",
    "url-loader": "^4.1.1"
  },
  "build": {
    "appId": "com.silverwalldisc.alto",
    "productName": "Alto",
    "copyright": "Copyright © 2024 SilverWallDiscs",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asar": false,
    "files": [
      "src/main/**/*",
      "build/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Alto"
    },
    "publish": {
      "provider": "github",
      "owner": "SilverWallDiscs",
      "repo": "Alto"
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
